<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />

<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<style>
    .testimonial-card{

    background:white;
    border-radius:16px;
    padding:2rem;

    box-shadow:
    0 8px 30px rgba(0,0,0,.08);

    display:flex;
    flex-direction:column;

    min-height:370px;
}

    .avatar-placeholder{

        width:80px;
        height:80px;

        margin:auto auto 20px;

        display:flex;
        justify-content:center;
        align-items:center;

        background:#f3f4f6;

        border-radius:9999px;

    }

    .placeholder-avatar{

        width:36px;
        height:36px;
    }

    .stars{

        text-align:center;

        color:#facc15;

        font-size:22px;

        margin-bottom:20px;

    }

    .review{

        text-align:center;

        color:#6b7280;

        line-height:1.9;

    }

    .customer{

        margin-top:30px;

        text-align:center;

    }

    .customer h3{

        font-weight:600;

        font-size:18px;

    }

    .customer span{

        color:#9ca3af;

        font-size:14px;

    }

    /* Equal Height */

    .testimonial-swiper .swiper-wrapper{

        align-items:stretch;

    }

    .testimonial-swiper .swiper-slide{

        display:flex;
        height:auto;

    }

    .testimonial-card{

        width:100%;
    }

    /* Emerald Pagination */

    .testimonial-pagination{

        position:relative;

        margin-top:40px;

    }

    .testimonial-pagination .swiper-pagination-bullet{

        width:10px;
        height:10px;

        background:#d1d5db;

        opacity:1;

        transition:.3s;

    }

    .testimonial-pagination .swiper-pagination-bullet-active{

        width:30px;

        border-radius:999px;

        background:#10b981;

    }
</style>

<section class="py-20" style="background: {{ section.settings.background_color }};">

    <div class="max-w-7xl mx-auto px-6">

        {% if section.settings.heading != blank %}
        <div class="text-center mb-12">

            <h2 class="font-bold" style="
            color: {{ section.settings.heading_color }};
            font-size: {{ section.settings.heading_size }}px;
          ">
                {{ section.settings.heading }}
            </h2>

        </div>
        {% endif %}

        <div class="swiper testimonial-swiper">

            <div class="swiper-wrapper">

                {% if section.blocks.size > 0 %}

                {% for block in section.blocks %}

                <div class="swiper-slide h-auto">

                    <div class="testimonial-card h-full flex flex-col" {{ block.shopify_attributes }}>

                        <!-- Avatar -->

                        {% if block.settings.image %}

                        <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.name }}"
                            class="w-20 h-20 rounded-full object-cover mx-auto mb-5" width="" height="" loading="lazy">

                        {% else %}

                        <div class="avatar-placeholder">

                            {{ 'image' | placeholder_svg_tag: 'placeholder-avatar' }}

                        </div>

                        {% endif %}

                        <!-- Stars -->

                        <div class="stars">

                            {% for i in (1..5) %}
                            ★
                            {% endfor %}

                        </div>

                        <!-- Review -->

                        <div class="flex-grow">

                            <p class="review">

                                {{ block.settings.review }}

                            </p>

                        </div>

                        <!-- Customer -->

                        <div class="customer">

                            <h3>{{ block.settings.name }}</h3>

                            <span>{{ block.settings.position }}</span>

                        </div>

                    </div>

                </div>

                {% endfor %}

                {% else %}

                {% for i in (1..3) %}

                <div class="swiper-slide h-auto">

                    <div class="testimonial-card h-full flex flex-col">

                        <div class="avatar-placeholder">

                            {{ 'image' | placeholder_svg_tag: 'placeholder-avatar' }}

                        </div>

                        <div class="stars">

                            ★★★★★

                        </div>

                        <div class="flex-grow">

                            <p class="review">

                                Add customer testimonials here to build trust with shoppers.

                            </p>

                        </div>

                        <div class="customer">

                            <h3>Customer Name</h3>

                            <span>Verified Buyer</span>

                        </div>

                    </div>

                </div>

                {% endfor %}

                {% endif %}

            </div>

            <div class="swiper-pagination testimonial-pagination"></div>

        </div>

    </div>

</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        new Swiper(".testimonial-swiper", {

            loop: true,

            speed: 700,

            spaceBetween: 24,

            autoplay: {
                delay: 4500,
                disableOnInteraction: false,
                pauseOnMouseEnter: true
            },

            pagination: {
                el: ".testimonial-pagination",
                clickable: true
            },

            breakpoints: {

                0: {
                    slidesPerView: 1
                },

                768: {
                    slidesPerView: 2
                },

                1024: {
                    slidesPerView: 3
                }

            }

        });

    });
</script>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F9FAFB"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Subtitle",
          "default": "Verified Buyer"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Absolutely love these shoes. Comfortable, stylish and high quality."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}