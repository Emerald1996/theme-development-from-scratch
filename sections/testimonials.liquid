<style>
    .testimonial-card {

        height: 100%;

        display: flex;

        flex-direction: column;

        padding: 2rem;

        background: #fff;

        border-radius: 20px;

        box-shadow: 0 15px 40px rgba(0, 0, 0, .08);

    }

    .customer-avatar {

        width: 90px;

        height: 90px;

        border-radius: 999px;

        margin: 0 auto 24px;

        object-fit: cover;

    }

    .customer-placeholder {

        width: 90px;

        height: 90px;

        margin: 0 auto 24px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #f3f4f6;

        border-radius: 999px;

    }

    .placeholder-icon {

        width: 40px;

        height: 40px;

    }

    .testimonial-stars {

        text-align: center;

        font-size: 24px;

        color: #facc15;

        margin-bottom: 20px;

    }

    .testimonial-review {

        flex-grow: 1;

        text-align: center;

        line-height: 1.9;

        color: #6b7280;

        margin-bottom: 32px;

    }

    .testimonial-author {

        text-align: center;

    }

    .testimonial-author h3 {

        font-weight: 700;

        font-size: 20px;

        margin-bottom: 6px;

    }

    .testimonial-author span {

        color: #9ca3af;

        font-size: 14px;

    }

    /* Equal height */

    .testimonial-swiper .swiper-wrapper {

        align-items: stretch;

    }

    .testimonial-swiper .swiper-slide {

        display: flex;

        height: auto;

    }

    /* Navigation */

    .swiper-button-prev,
    .swiper-button-next {

        width: 20px;

        height: 20px;

        background: white;

        border-radius: 999px;

        box-shadow: 0 8px 30px rgba(0, 0, 0, .15);

        color: #111827;

    }

    /* .swiper-button-prev:hover,
    .swiper-button-next:hover {

        background: #10b981;
        padding: 10px;
        color: white;

    } */

    .swiper-button-prev::after,
    .swiper-button-next::after {

        font-size: 18px;

        font-weight: bold;

    }

    /* Pagination */

    .swiper-pagination {

        position: relative;

        margin-top: 40px;

    }

    .swiper-pagination-bullet {

        width: 12px;

        height: 12px;

        background: #d1d5db;

        opacity: 1;

        transition: .3s;

    }

    .swiper-pagination-bullet-active {

        width: 34px;

        border-radius: 999px;

        background: #10b981;

    }

    @media(max-width:768px) {

        .swiper-button-prev {

            left: -5px;

        }

        .swiper-button-next {

            right: -5px;

        }

    }
</style>

<section class="testimonial-section py-20" style="background:{{ section.settings.background_color }};">

    <div class="max-w-7xl mx-auto px-6">

        {% if section.settings.heading != blank %}

        <div class="text-center mb-14">

            <h2 class="font-bold" style="
        color:{{ section.settings.heading_color }};
        font-size:{{ section.settings.heading_size }}px;
        ">

                {{ section.settings.heading }}

            </h2>

        </div>

        {% endif %}

        <div class="relative">

            <div id="testimonial-swiper-{{ section.id }}" class="swiper testimonial-swiper">

                <div class="swiper-wrapper">

                    {% if section.blocks.size > 0 %}

                    {% for block in section.blocks %}

                    <div class="swiper-slide h-auto" {{ block.shopify_attributes }}>

                        <article class="testimonial-card">

                            {% if block.settings.image %}

                            <img src="{{ block.settings.image | image_url: width:120 }}" width="" height="" class="customer-avatar"
                                alt="{{ block.settings.name }}" loading="lazy">

                            {% else %}

                            <div class="customer-placeholder">

                                {{ 'image' | placeholder_svg_tag: 'placeholder-icon' }}

                            </div>

                            {% endif %}

                            <div class="testimonial-stars">

                                ★★★★★

                            </div>

                            <div class="testimonial-review">

                                {{ block.settings.review }}

                            </div>

                            <div class="testimonial-author">

                                <h3>

                                    {{ block.settings.name }}

                                </h3>

                                <span>

                                    {{ block.settings.position }}

                                </span>

                            </div>

                        </article>

                    </div>

                    {% endfor %}

                    {% else %}

                    {% for i in (1..6) %}

                    <div class="swiper-slide h-auto">

                        <article class="testimonial-card">

                            <div class="customer-placeholder">

                                {{ 'image' | placeholder_svg_tag: 'placeholder-icon' }}

                            </div>

                            <div class="testimonial-stars">

                                ★★★★★

                            </div>

                            <div class="testimonial-review">

                                Add testimonials to build trust with your customers.

                            </div>

                            <div class="testimonial-author">

                                <h3>

                                    Customer Name

                                </h3>

                                <span>

                                    Verified Buyer

                                </span>

                            </div>

                        </article>

                    </div>

                    {% endfor %}

                    {% endif %}

                </div>

            </div>

            <div class="swiper-button-prev testimonial-prev-{{ section.id }}"></div>

            <div class="swiper-button-next testimonial-next-{{ section.id }}"></div>

            <div class="swiper-pagination testimonial-pagination-{{ section.id }}"></div>

        </div>

    </div>
</section>

<script>

    (function () {

        function initTestimonials() {

            const slider = document.querySelector("#testimonial-swiper-{{ section.id }}");

            if (!slider) return;

            if (slider.swiper) {

                slider.swiper.destroy(true, true);

            }

            new Swiper(slider, {

                loop: true,

                speed: 700,

                spaceBetween: 24,

                grabCursor: true,

                watchOverflow: true,

                observer: true,

                observeParents: true,

                autoplay: {

                    delay: 4500,

                    disableOnInteraction: false,

                    pauseOnMouseEnter: true

                },

                navigation: {

                    nextEl: ".testimonial-next-{{ section.id }}",

                    prevEl: ".testimonial-prev-{{ section.id }}"

                },

                pagination: {

                    el: ".testimonial-pagination-{{ section.id }}",

                    clickable: true

                },

                breakpoints: {

                    0: {

                        slidesPerView: 1

                    },

                    768: {

                        slidesPerView: 2

                    },

                    1024: {

                        slidesPerView: 3

                    }

                }

            });

        }

        document.addEventListener("DOMContentLoaded", initTestimonials);

        document.addEventListener("shopify:section:load", initTestimonials);

        document.addEventListener("shopify:block:select", initTestimonials);

    })();

</script>

{% schema %}
{
  "name":"Testimonials",
  "settings":[
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"What Our Customers Say"
    },
    {
      "type":"range",
      "id":"heading_size",
      "min":24,
      "max":60,
      "step":2,
      "default":38,
      "label":"Heading Size"
    },
    {
      "type":"color",
      "id":"heading_color",
      "default":"#111827",
      "label":"Heading Color"
    },
    {
      "type":"color",
      "id":"background_color",
      "default":"#f9fafb",
      "label":"Background Color"
    }
  ],
  "blocks":[
    {
      "type":"testimonial",
      "name":"Testimonial",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Customer Photo"
        },
        {
          "type":"text",
          "id":"name",
          "label":"Customer Name",
          "default":"John Doe"
        },
        {
          "type":"text",
          "id":"position",
          "label":"Subtitle",
          "default":"Verified Buyer"
        },
        {
          "type":"textarea",
          "id":"review",
          "label":"Review",
          "default":"These shoes exceeded my expectations. Stylish, comfortable, and durable!"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Testimonials"
    }
  ]
}
{% endschema %}